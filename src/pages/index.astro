---
import Base from '../layouts/Base.astro';
import Products from '../components/Products.astro';
import rates from '../data/rates-2026.json';
import { computeLabor, type Rates } from '../lib/engine';
const avgGross = rates.wages.average;
const avgNet = computeLabor({ contract: 'uop', monthly: avgGross, under26: false }, rates as unknown as Rates).net / 12;
const fmt = (n: number) => Math.round(n).toLocaleString('pl-PL');
---
<Base title="Kalkulator" path="/" description="Wpisz pensję i zobacz wszystkie podatki i składki, które płacisz: ZUS, NFZ, PIT, VAT i akcyzę w cenach. Z wyjaśnieniem, kiedy, gdzie i na co idą Twoje pieniądze. Dane i przepisy na 2026 r.">
  <section class="sec hero" id="start">
    <div class="wrap hero-in">
      <div class="hero-copy">
        <p class="kicker"><b>1</b> Twoja pensja</p>
        <h1 class="h1">Ile naprawdę oddajesz państwu?</h1>
        <p class="lead">Na pasku płacowym widać tylko część podatków i składek. Resztę płaci za Ciebie pracodawca albo sklep – w cenach zakupów. Wpisz, ile dostajesz na konto, a w minutę zobaczysz <strong>całość</strong>: ile, kiedy i na co.</p>
        <ul class="hero-points">
          <li><span class="dot g-you"></span>Liczone z ustaw i danych GUS na {new Date(rates.meta.asOf).toLocaleDateString('pl-PL', { day: 'numeric', month: 'long', year: 'numeric' })}</li>
          <li><span class="dot g-zus"></span>Przy każdej liczbie: skąd ją wzięliśmy</li>
          <li><span class="dot g-vat"></span>Wpisane kwoty nie opuszczają Twojego urządzenia</li>
        </ul>
      </div>
      <form class="card calc" id="calc" novalidate>
        <div class="field">
          <label for="amount" id="amount-label">Ile dostajesz co miesiąc?</label>
          <div class="money"><input id="amount" name="amount" inputmode="numeric" autocomplete="off" value={fmt(avgNet)} aria-describedby="amount-hint" /><span>zł</span></div>
          <p class="hint" id="amount-hint">Wpisaliśmy przeciętną pensję: {fmt(avgNet)} zł na rękę, czyli {fmt(avgGross)} zł brutto ({rates.wages.averageLabel}). Zmień na swoją.</p>
        </div>
        <fieldset class="field fs">
          <legend class="lbl">To kwota…</legend>
          <div class="seg">
            <label><input type="radio" name="amountIs" value="net" checked /><span>na rękę (tyle wpływa na konto)</span></label>
            <label><input type="radio" name="amountIs" value="gross" /><span>brutto (tyle jest w umowie)</span></label>
          </div>
        </fieldset>
        <fieldset class="field fs">
          <legend class="lbl">Forma pracy</legend>
          <div class="seg">
            <label><input type="radio" name="contract" value="uop" checked /><span>Umowa o pracę</span></label>
            <label><input type="radio" name="contract" value="zlecenie" /><span>Zlecenie</span></label>
            <label><input type="radio" name="contract" value="b2b" /><span>Firma (B2B)</span></label>
          </div>
        </fieldset>
        <div class="b2b-opts inp-row" data-show="b2b" hidden>
          <div class="field"><label for="b2bTax">Forma opodatkowania</label>
            <select id="b2bTax" name="b2bTax"><option value="liniowy">Podatek liniowy 19%</option><option value="ryczalt">Ryczałt</option><option value="skala">Skala podatkowa (12/32%)</option></select></div>
          <div class="field" data-show="ryczalt" hidden><label for="ryczaltRate">Stawka ryczałtu</label>
            <select id="ryczaltRate" name="ryczaltRate">{rates.b2b.ryczaltRates.map((r) => <option value={r} selected={r === 0.12}>{(r * 100).toLocaleString('pl-PL')}%</option>)}</select></div>
          <div class="field"><label for="b2bZus">ZUS</label>
            <select id="b2bZus" name="b2bZus"><option value="duzy">Pełny („duży”) ZUS</option><option value="preferencyjny">Preferencyjny (pierwsze 2 lata)</option><option value="ulga">Ulga na start (pierwsze 6 mies.)</option></select></div>
          <div class="field"><label for="b2bCosts">Koszty firmy miesięcznie (netto)</label>
            <input class="inp" id="b2bCosts" name="b2bCosts" inputmode="numeric" value="0" /></div>
        </div>
        <label class="check"><input type="checkbox" name="under26" id="under26" /><span>Mam mniej niż 26 lat <span class="hint">(ulga dla młodych: bez PIT do {fmt(rates.pit.youngLimit)} zł rocznie)</span></span></label>
        <label class="check" data-show="zlecenie" hidden><input type="checkbox" name="student" id="student" /><span>Jestem uczniem lub studentem (zlecenie bez ZUS)</span></label>
        <button class="btn btn--primary" type="submit">Pokaż, ile oddaję <span aria-hidden="true">→</span></button>
      </form>
    </div>
  </section>

  <section class="sec" id="zgadnij" hidden>
    <div class="wrap narrow">
      <p class="kicker"><b>2</b> Zanim zobaczysz wynik</p>
      <h2 class="h2">Zgadnij: ile z każdych 100 zł trafia do państwa?</h2>
      <p class="lead">Twój pracodawca wydaje na Ciebie co miesiąc więcej, niż masz w umowie. Z każdych 100 zł tej kwoty – ile w sumie trafia do państwa, licząc też podatki w sklepie? Najpierw zgadnij, potem porównaj.</p>
      <div class="card guess">
        <label for="guess" class="guess-lbl">Moim zdaniem: <output id="guess-out" class="num">25 zł</output> ze 100 zł</label>
        <input type="range" id="guess" min="0" max="90" step="1" value="25" />
        <div class="guess-scale" aria-hidden="true"><span>0 zł</span><span>45 zł</span><span>90 zł</span></div>
        <div class="guess-actions">
          <button class="btn btn--primary" type="button" id="guess-go">Sprawdź</button>
          <button class="btn btn--ghost" type="button" id="guess-skip">Pomiń</button>
        </div>
      </div>
    </div>
  </section>

  <div id="results" hidden>
    <div class="sticky" id="sticky" role="region" aria-label="Podsumowanie i ustawienia">
      <div class="wrap sticky-in">
        <p class="sticky-total"><span id="st-label">Oddajesz miesięcznie</span> <span class="st-nums"><strong class="num" id="st-amount">—</strong> <span class="sticky-pct num" id="st-pct">—</span></span></p>
        <div class="sticky-ctrl">
          <div class="seg seg-sm" role="group" aria-label="Okres">
            <button type="button" data-period="m" aria-pressed="true">miesiąc</button>
            <button type="button" data-period="y" aria-pressed="false">rok</button>
          </div>
          <label class="switch"><input type="checkbox" id="zusAsTax" checked /><span><span class="sw-long">Liczę składki emerytalne i rentowe jako podatek</span><span class="sw-short" aria-hidden="true">składki ZUS = podatek</span></span></label>
          <a class="btn btn--ghost btn--small" href="#dopasuj">Dopasuj</a>
        </div>
      </div>
    </div>

    <section class="sec" id="wynik">
      <div class="wrap">
        <p class="kicker"><b>3</b> Wynik</p>
        <h2 class="h2 big-result" id="big-result">—</h2>
        <p class="guess-cmp" id="guess-cmp" hidden></p>
        <div class="three" id="three"></div>
        <p class="lead big-sub" id="big-sub"></p>
        <p class="note pension-note">W tej kwocie są też składki emerytalne i rentowe: są obowiązkowe, ale wrócą do Ciebie jako emerytura lub renta. Jeśli nie chcesz ich liczyć jako podatku, wyłącz przełącznik na górnym pasku.</p>
      </div>
    </section>

    <section class="sec" id="droga">
      <div class="wrap">
        <div class="head">
          <p class="kicker"><b>4</b> Droga Twoich pieniędzy</p>
          <h2 class="h2">Od tego, co wydaje pracodawca, do tego, co naprawdę możesz kupić</h2>
          <p class="lead">Czytaj od góry: każdy pasek to te same pieniądze na kolejnym etapie. Kolorowe kawałki to podatki i składki zabierane po drodze, a paski w kratkę – to, co zabrano już wcześniej.</p>
        </div>
        <ol class="flow" id="flow"></ol>
      </div>
    </section>

    <section class="sec" id="monety">
      <div class="wrap">
        <div class="head">
          <p class="kicker"><b>5</b> Z każdych 100 zł</p>
          <h2 class="h2">Kto dostaje Twoje pieniądze</h2>
          <p class="lead">Każda moneta to 1 zł z każdych 100 zł, które pracodawca wydaje na Ciebie. Kolor pokazuje, dokąd trafia.</p>
        </div>
        <div class="coins-wrap card">
          <div class="coins" id="coins" role="img"></div>
          <ul class="legend" id="coins-legend"></ul>
        </div>
        <details class="why"><summary>Dlaczego liczymy od pełnego kosztu pracy, a nie od pensji brutto?</summary><div>
          <p>Część składek ZUS płaci pracodawca, ale tylko dlatego, że Cię zatrudnia: to koszt Twojego stanowiska pracy. Ekonomiści (np. OECD w raporcie „Taxing Wages”) liczą obciążenie pracy właśnie od tej kwoty, nazywanej potocznie „brutto-brutto”. Dzięki temu można porównać umowę o pracę z B2B i Polskę z innymi krajami.</p></div></details>
        <details class="why"><summary>Co zmienia przełącznik „Liczę składki emerytalne i rentowe jako podatek”?</summary><div>
          <p>Składki emerytalne i rentowe różnią się od podatku: trafiają na Twoje indywidualne konto w ZUS i zwiększają przyszłą emeryturę. Z drugiej strony są obowiązkowe, a dzisiejsze wpłaty od razu finansują wypłaty obecnych emerytów (system repartycyjny). Dlatego pokazujemy obie wersje. Po wyłączeniu przełącznika te składki są osobną pozycją „odłożone na emeryturę”.</p></div></details>
      </div>
    </section>

    <section class="sec" id="paragon">
      <div class="wrap grid-2">
        <div>
          <p class="kicker"><b>6</b> Paragon od państwa</p>
          <h2 class="h2">Gdyby państwo wystawiało paragon</h2>
          <p class="lead">Wszystkie podatki i składki z jednego miesiąca lub roku w jednym miejscu. Pozycje w tej samej kolejności, w jakiej pieniądze znikają: najpierw u pracodawcy, potem z pensji, na końcu w sklepie.</p>
          <div class="seg seg-sm period-inline" role="group" aria-label="Okres paragonu">
            <button type="button" data-period="m" aria-pressed="true">miesiąc</button>
            <button type="button" data-period="y" aria-pressed="false">rok</button>
          </div>
          <details class="why"><summary>Skąd te kwoty?</summary><div>
            <p>Składki i PIT wynikają wprost z ustaw dla Twojej pensji. VAT i akcyza to szacunek: bierzemy typowe wydatki gospodarstw domowych o podobnym dochodzie (GUS, „Budżety gospodarstw domowych”) i stawki podatku w każdej kategorii. W sekcji „Dopasuj” możesz podać swoje zużycie paliwa, prądu, papierosów i alkoholu. Wtedy te pozycje liczymy dokładnie. Szczegóły na stronie <a href="/metodologia/">Metodologia</a>.</p></div></details>
        </div>
        <div class="receipt" id="receipt" aria-live="polite"></div>
      </div>
    </section>

    <Products />

    <div class="more-gate" id="more-gate"><div class="wrap"><p class="lead">Wiesz już najważniejsze. Poniżej: kiedy płacisz, Twój dzień wolności podatkowej, na co państwo wydaje pieniądze i jak dopasować wynik do siebie.</p><button class="btn btn--primary" type="button" id="more-btn" aria-expanded="false" aria-controls="more">Pokaż więcej <span aria-hidden="true">↓</span></button></div></div>
    <div id="more" hidden>

    <section class="sec" id="kiedy">
      <div class="wrap">
        <div class="head">
          <p class="kicker"><b>8</b> Kiedy i gdzie płacisz</p>
          <h2 class="h2">Kiedy i jak płacisz – często nawet o tym nie wiedząc</h2>
          <p class="lead">Większości podatków nie płacisz sam: robi to za Ciebie pracodawca, sklep, stacja paliw albo elektrownia. Dlatego tak łatwo ich nie zauważyć.</p>
        </div>
        <ol class="timeline" id="timeline"></ol>
      </div>
    </section>

    <section class="sec" id="kalendarz">
      <div class="wrap">
        <div class="head">
          <p class="kicker"><b>9</b> Twój rok i Twój dzień</p>
          <h2 class="h2" id="cal-title">—</h2>
          <p class="lead" id="cal-lead"></p>
        </div>
        <div class="card cal-card">
          <div class="cal" id="cal" role="img"></div>
          <ul class="legend" id="cal-legend"></ul>
        </div>
        <div class="card clock-card">
          <h3 class="h3" id="clock-title">—</h3>
          <div class="clock" id="clock" role="img"></div>
          <div class="clock-scale" aria-hidden="true"><span>8:00</span><span>10:00</span><span>12:00</span><span>14:00</span><span>16:00</span></div>
        </div>
        <details class="why"><summary>Czym jest „dzień wolności podatkowej”?</summary><div>
          <p>To obrazowy sposób pokazania, jaką część zarobków zabierają podatki i składki: gdyby cały zarobek z początku roku szedł najpierw na podatki i składki, to od tego dnia zarabiasz już tylko dla siebie. Centrum im. Adama Smitha liczy taki dzień dla całej Polski (w {rates.meta.year} r. wypadł {new Date(rates.context.casFreedomDay).toLocaleDateString('pl-PL', { day: 'numeric', month: 'long' })}), ale z innej metody: z relacji wszystkich wydatków publicznych do PKB, łącznie z deficytem. Twój dzień liczymy z Twoich podatków i składek, więc wynik się różni.</p></div></details>
      </div>
    </section>

    <section class="sec" id="na-co">
      <div class="wrap">
        <div class="head">
          <p class="kicker"><b>10</b> Na co idą Twoje pieniądze</p>
          <h2 class="h2" id="where-title">—</h2>
          <p class="lead">Podział według tego, na co państwo (rząd, ZUS, NFZ i samorządy razem) wydaje pieniądze. Wydatki państwa w {rates.cofog.year} r. rozłożyliśmy proporcjonalnie na Twoje podatki i składki.</p>
        </div>
        <ul class="where" id="where"></ul>
        <details class="why"><summary>Dlaczego proporcjonalnie?</summary><div>
          <p>Pieniądze z różnych podatków i składek w dużej mierze mieszają się w budżecie, a ZUS i NFZ i tak dostają dotacje z podatków. Dlatego, tak jak robią to brytyjski urząd skarbowy (HMRC) czy australijski ATO w „paragonach podatkowych”, dzielimy Twoje podatki i składki według struktury wydatków całego sektora publicznego (klasyfikacja COFOG, Eurostat).</p></div></details>
      </div>
    </section>

    <section class="sec" id="w-zamian">
      <div class="wrap">
        <div class="head">
          <p class="kicker"><b>11</b> Druga strona rachunku</p>
          <h2 class="h2">Co państwo wydaje na przeciętnego mieszkańca</h2>
          <p class="lead">Podatki i składki to nie tylko koszt. Wracają jako emerytury, leczenie, szkoły, drogi czy bezpieczeństwo. Dla uczciwego obrazu pokazujemy obie strony.</p>
        </div>
        <div class="return-grid" id="returns"></div>
      </div>
    </section>


    <section class="sec" id="dopasuj">
      <div class="wrap">
        <div class="head">
          <p class="kicker"><b>12</b> Dopasuj do siebie</p>
          <h2 class="h2">Im więcej powiesz, tym dokładniejszy wynik</h2>
          <p class="lead">Puste pole = średnia GUS dla gospodarstw o podobnym dochodzie. Wszystko przelicza się od razu.</p>
        </div>
        <form class="card fit" id="fit" novalidate>
          <fieldset class="fit-group"><legend class="h3">Gospodarstwo domowe</legend>
            <div class="inp-row">
              <div class="field"><label for="persons">Ile osób utrzymuje się z tych dochodów?</label><input class="inp" id="persons" name="persons" type="number" min="1" max="12" value="1" /></div>
              <div class="field"><label for="children">Dzieci z ulgą prorodzinną</label><input class="inp" id="children" name="children" type="number" min="0" max="10" value="0" /></div>
              <div class="field"><label for="partner">Druga osoba zarabia na rękę (zł miesięcznie)</label><input class="inp" id="partner" name="partner" inputmode="numeric" placeholder="np. 5000" /></div>
            </div>
          </fieldset>
          <fieldset class="fit-group"><legend class="h3">Zakupy z akcyzą</legend>
            <div class="inp-row">
              <div class="field"><label for="fuel">Paliwo: litrów miesięcznie</label><input class="inp" id="fuel" name="fuel" inputmode="decimal" placeholder="średnia GUS" /><p class="hint">Np. 1000 km autem spalającym 7 l = 70 l</p></div>
              <div class="field"><label for="fuelType">Rodzaj paliwa</label><select id="fuelType" name="fuelType"><option value="petrol">Benzyna</option><option value="diesel">Diesel</option></select></div>
              <div class="field"><label for="packs">Papierosy: paczek tygodniowo</label><input class="inp" id="packs" name="packs" inputmode="decimal" placeholder="średnia GUS" /></div>
              <div class="field"><label for="kwh">Prąd: kWh miesięcznie</label><input class="inp" id="kwh" name="kwh" inputmode="decimal" placeholder="średnia GUS" /><p class="hint">Mieszkanie 2 os. to zwykle 150–200 kWh</p></div>
            </div>
            <div class="inp-row">
              <div class="field"><label for="beers">Piwo: butelek 0,5 l tygodniowo</label><input class="inp" id="beers" name="beers" inputmode="decimal" placeholder="średnia GUS" /></div>
              <div class="field"><label for="vodka">Wódka: butelek 0,5 l miesięcznie</label><input class="inp" id="vodka" name="vodka" inputmode="decimal" placeholder="średnia GUS" /></div>
              <div class="field"><label for="wine">Wino: butelek 0,75 l miesięcznie</label><input class="inp" id="wine" name="wine" inputmode="decimal" placeholder="średnia GUS" /></div>
            </div>
          </fieldset>
          <fieldset class="fit-group"><legend class="h3">Mieszkanie i oszczędności</legend>
            <div class="inp-row">
              <div class="field"><label for="m2">Mieszkanie lub dom na własność: m²</label><input class="inp" id="m2" name="m2" inputmode="decimal" placeholder="0 = wynajmuję" /></div>
              <div class="field"><label for="savings">Ile procent dochodu odkładasz?</label><input class="inp" id="savings" name="savings" inputmode="decimal" placeholder="średnia GUS" /></div>
              <div class="field"><label for="capital">Odsetki i zyski z inwestycji rocznie (zł)</label><input class="inp" id="capital" name="capital" inputmode="decimal" placeholder="0" /></div>
            </div>
            <label class="check"><input type="checkbox" id="rtv" name="rtv" /><span>Płacę abonament RTV</span></label>
          </fieldset>
          <p class="note" id="fit-note"></p>
        </form>
      </div>
    </section>

    </div>

    <section class="sec" id="udostepnij">
      <div class="wrap share">
        <div>
          <p class="kicker"><b>13</b> Podziel się</p>
          <h2 class="h2">Pokaż innym, jak działa system</h2>
          <p class="lead">Obrazek pokazuje tylko procenty i datę, bez Twoich kwot. Link otwiera kalkulator z tymi samymi ustawieniami; dane są w części linku, której przeglądarka nie wysyła na serwer.</p>
          <div class="share-actions">
            <button class="btn btn--primary" type="button" id="share-img">Pobierz obrazek</button>
            <button class="btn btn--ghost" type="button" id="share-link">Kopiuj link</button>
            <span class="note" id="share-msg" role="status"></span>
          </div>
        </div>
        <canvas id="share-canvas" width="1200" height="630" class="share-canvas" aria-label="Podgląd obrazka do udostępnienia"></canvas>
      </div>
    </section>
  </div>

  <noscript><div class="wrap sec"><p class="body">Kalkulator liczy w przeglądarce i potrzebuje JavaScriptu. Opis zasad i wszystkie stawki znajdziesz na stronach <a href="/jak-dziala-system/">Jak działa system</a> i <a href="/metodologia/">Metodologia</a>.</p></div></noscript>
</Base>

<script>
  import '../scripts/app';
</script>

<style is:global>
  .hero { padding-top: clamp(32px, 5vw, 64px); }
  .hero-in { display: grid; gap: clamp(24px, 4vw, 56px); grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); align-items: center; }
  .hero-points { margin-top: 22px; display: grid; gap: 8px; color: var(--muted); font-size: 15px; }
  .hero-points li { display: flex; gap: 10px; align-items: center; }
  .calc { display: grid; gap: 18px; }
  .fs { border: 0; padding: 0; margin: 0; }
  .fs legend { margin-bottom: 8px; padding: 0; }
  .narrow { max-width: 820px; }
  .guess { margin-top: 28px; display: grid; gap: 14px; }
  .guess-lbl { font-family: var(--display); font-size: clamp(1.2rem, 1rem + 1vw, 1.6rem); font-weight: 600; }
  .guess-lbl output { color: var(--accent); }
  input[type='range'] { width: 100%; accent-color: var(--accent); height: 32px; }
  .guess-scale { display: flex; justify-content: space-between; font-size: 13px; color: var(--faint); }
  .guess-actions, .share-actions { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; }
  .sticky { position: sticky; top: 64px; z-index: 40; background: var(--panel); border-bottom: 1px solid var(--line); box-shadow: var(--shadow); }
  .sticky-in { display: flex; flex-wrap: wrap; gap: 8px 20px; align-items: center; justify-content: space-between; padding-block: 8px; }
  .sticky-total { font-size: 15px; color: var(--muted); min-width: 0; }
  .st-nums { white-space: nowrap; }
